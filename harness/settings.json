{
  "model": "claude-sonnet-5",
  "fallbackModel": ["claude-opus-5", "claude-haiku-4-5"],
  "advisorModel": "opus",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/bash-guard.sh"
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-daltonized"
}
